{
  "name": "open-token-board",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "pnpm --filter @open-token-board/web dev",
    "build": "pnpm pack:agent && pnpm --filter @open-token-board/web build",
    "start": "pnpm --filter @open-token-board/web start",
    "test": "pnpm typecheck && pnpm agent:help",
    "test:api": "node --import tsx --test tests/api/*.test.ts",
    "test:e2e": "playwright test tests/e2e",
    "typecheck": "pnpm -r --if-present typecheck",
    "pack:agent": "node scripts/pack-agent.mjs",
    "verify:new-sources": "pnpm --dir apps/token-board-api exec tsx ../../scripts/verify-new-sources-fixtures.ts",
    "agent:help": "node tools/token-board-agent-npx/bin/token-board-agent.mjs help",
    "token:server": "pnpm --filter @open-token-board/api token:server",
    "selection:server": "pnpm --filter @open-token-board/api selection:server",
    "token:migrate-json": "pnpm --filter @open-token-board/api token:migrate-json",
    "token:agent": "pnpm --filter @open-token-board/api token:agent",
    "token:agent:watch": "pnpm --filter @open-token-board/api token:agent:watch",
    "token:service": "pnpm --filter @open-token-board/service token:server",
    "codex:limits": "pnpm --filter @open-token-board/codex-limits start",
    "codex:limits:watch": "pnpm --filter @open-token-board/codex-limits watch",
    "codex:limits:serve": "pnpm --filter @open-token-board/codex-limits serve"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "tsx": "4.23.11"
  }
}
